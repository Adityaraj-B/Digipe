# =====================================================
# SERVER
# =====================================================
NODE_ENV=development
PORT=5000

# =====================================================
# MONGODB
# =====================================================
MONGODB_URI=mongodb://localhost:27017/digipe_insurance

# =====================================================
# JWT
# =====================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h

# =====================================================
# SUREFY AUTH (Digipe)
# =====================================================
SUREFY_AUTH_BASE_URL=https://auth.surefy.co/api/v1
SUREFY_API_KEY=YOUR-SUREFY-API-KEY

# =====================================================
# CLOUDINARY
# =====================================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =====================================================
# CORS
# =====================================================
CORS_ORIGIN=http://localhost:3000

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =====================================================
# CASHFREE PAYMENT GATEWAY
# =====================================================
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=sandbox
FRONTEND_SUCCESS_URL=http://localhost:3000/payment/success
FRONTEND_FAILURE_URL=http://localhost:3000/payment/failure

# =====================================================
# HUBBLE SDK (Gift Card Store)
# =====================================================
HUBBLE_CLIENT_ID=your-hubble-client-id
HUBBLE_CLIENT_SECRET=your-hubble-client-secret
HUBBLE_SDK_BASE_URL=https://sdk.dev.myhubble.money/
HUBBLE_SSO_PRIVATE_KEY_PATH=./keys/hubble_private_key.pem

# =====================================================
# FIREBASE CLOUD MESSAGING (Push Notifications)
# =====================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
